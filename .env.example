NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL="postgresql://e2:e2password@localhost:5432/e2"

CORS_ORIGIN=*

SHUTDOWN_TIMEOUT_MS=10000

# How far ahead /api/v1/yard/overview looks for upcoming arrivals
ARRIVAL_HORIZON_MINUTES=120

# --- Simulation (Phase 4) ---
# Backend tick cadence. Locked at 2s by the spec; the frontend interpolates between ticks.
SIMULATION_TICK_MS=2000
# Start the simulation loop on server boot. Always off under NODE_ENV=test.
SIMULATION_AUTOSTART=true
# 1 = real time. Raise to compress a demo (ETA scales with it).
SIMULATION_SPEED_MULTIPLIER=1
# Progress % at which a moving truck flips to ARRIVING
SIMULATION_ARRIVING_PROGRESS=95
# Progress % between periodic LocationHistory checkpoints (never one row per tick)
SIMULATION_CHECKPOINT_PROGRESS_STEP=5

# --- Delay scenarios (Phase 6) ---
# Effective speed = base speed x the multiplier for the truck's active scenario.
# Must all be > 0: base speed is recovered by dividing a stored speed by its
# multiplier, and a zero-speed truck stops emitting entirely.
DELAY_MULTIPLIER_RAIN=0.65
DELAY_MULTIPLIER_TRAFFIC=0.45
# A very strong slowdown, not a full stop.
DELAY_MULTIPLIER_ROAD_CLOSURE=0.1

# --- Docking (Phase 7) ---
# Dock time assumed for a truck with no appointment. Matches the schema default
# on Appointment.expectedDurationMinutes.
DOCK_DEFAULT_DURATION_MINUTES=45
